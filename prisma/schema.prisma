generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// AUTHENTICATION
// ============================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      UserRole @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  adminPushSubscriptions AdminPushSubscription[]
}

enum UserRole {
  ADMIN
  VIEWER
}

// ============================================
// CLIENT MANAGEMENT
// ============================================

model Client {
  id     String       @id @default(cuid())
  slug   String       @unique
  status ClientStatus @default(ACTIVE)

  // Short subdomain for the hosted site (e.g. "collision" →
  // collision.glassleads.app). Provisioned via the admin: creates the
  // Cloudflare CNAME and attaches the domain to the Vercel project. The
  // site also always answers on {slug}.glassleads.app and /sites/{slug}.
  siteSubdomain String? @unique

  // Business Info
  businessName  String
  contactPerson String?
  phone         String
  email         String
  streetAddress String
  city          String
  state         String
  postalCode    String
  country       String  @default("US")

  // Service Details
  hasShopLocation        Boolean  @default(true)
  offersMobileService    Boolean  @default(false)
  serviceAreas           String[] // Array of cities/neighborhoods
  insuranceRelationships String[]

  // Services Offered
  offersWindshieldRepair      Boolean @default(true)
  offersWindshieldReplacement Boolean @default(true)
  offersSideWindowRepair      Boolean @default(false)
  offersBackWindowRepair      Boolean @default(false)
  offersSunroofRepair         Boolean @default(false)
  offersRockChipRepair        Boolean @default(true)
  offersAdasCalibration       Boolean @default(false)

  // Brand Settings
  logoUrl        String?
  primaryColor   String? @default("#1e40af")
  secondaryColor String? @default("#3b82f6")
  accentColor    String? @default("#f59e0b")

  timezone String @default("America/Denver")

  // Client Portal
  portalPassword String? // Encrypted

  // Browser origins allowed to POST leads directly to the webhook (CORS).
  // Managed in the admin UI; unioned with the hardcoded fallback list in the
  // webhook route so an empty database can never lock out a known site.
  allowedOrigins String[] @default([])

  // Google Places / Maps
  googlePlaceId String? // Google Places API place_id
  googleMapsUrl String? // Direct link to Google Maps

  // Subscription Management
  subscriptionStatus    SubscriptionStatus @default(TRIAL)
  subscriptionPlan      SubscriptionPlan   @default(STARTER)
  subscriptionStartDate DateTime?
  subscriptionEndDate   DateTime?
  billingEmail          String?
  stripeCustomerId      String?
  stripeSubscriptionId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Call Coaching (Deepgram + Claude analysis on phone leads)
  callCoachingEnabled Boolean @default(true)

  // Leads & Client Portal
  leads        Lead[]
  clientUsers  ClientUser[]
  callAnalyses CallAnalysis[]

  // Outbound lead forwarding (webhook fan-out)
  webhookDestinations WebhookDestination[]

  // Cached Google Business Profile reviews (hosted landing pages)
  gbpReviews ClientGbpReviews?

  // Additional shops. A client with one location keeps using the scalar
  // address fields above; rows here take over as soon as any exist.
  locations ClientLocation[]

  // Google Ads conversion tracking for the hosted site
  adsTracking ClientAdsTracking?

  // The client's own domains pointed at their hosted site
  domains ClientDomain[]

  // Per-city copy that makes a location page worth indexing
  cityContent ClientCityContent[]

  // Editorial content + photos for the hosted site
  siteContent ClientSiteContent?
  sitePhotos  ClientSitePhoto[]

  // Admin Push Notification Subscriptions
  adminPushSubscriptions AdminPushSubscriptionClient[]
}

enum ClientStatus {
  ACTIVE
  PAUSED
  ONBOARDING
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum SubscriptionPlan {
  STARTER // Basic plan
  GROWTH // Mid-tier
  ENTERPRISE // Full service
}

// ============================================
// LEADS (from Google Ads via HighLevel)
// ============================================

model Lead {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Contact Info
  email     String?
  phone     String?
  firstName String?
  lastName  String?

  // Google Ads Tracking (used for paid/organic attribution)
  gclid  String? // Google Click ID
  gbraid String? // Google GBRAID for iOS 14+
  wbraid String? // Google WBRAID for web-to-app

  // UTM Parameters (from your tracking template)
  utmSource    String? // adwords
  utmMedium    String? // {adname}
  utmCampaign  String? // {campaignname}
  utmContent   String? // {adgroupname}
  utmKeyword   String? // {keyword}
  utmMatchtype String? // {matchtype}
  campaignId   String? // {campaignid}
  adGroupId    String? // {adgroupid}
  adId         String? // {creative}

  // Lead Source
  source         LeadSource @default(FORM)
  landingPageUrl String?
  referrerUrl    String?

  // Form Data (store any extra fields)
  formData Json? // { vehicleType: "truck", zipCode: "85001", message: "..." }
  formName String? // Which form submitted (e.g., "homepage-quote", "mobile-landing")

  // HighLevel Reference
  highlevelContactId String?

  // Phone Call Data
  callRecordingUrl String? // URL to call recording from HighLevel
  callAnalyses     CallAnalysis[]

  // Outbound webhook deliveries created for this lead
  webhookDeliveries WebhookDelivery[]

  // Lead Status (updated by client)
  status          LeadStatus @default(NEW)
  statusUpdatedAt DateTime?
  statusUpdatedBy String? // ClientUser ID who updated

  // Qualification
  qualified          Boolean? // null = not yet assessed
  qualifiedAt        DateTime?
  qualificationNotes String?

  // Quote Info
  quoteValue Float? // Quote amount when status is QUOTED

  // Sale Info
  saleValue    Float? // Revenue amount if sold
  saleCurrency String    @default("USD")
  saleDate     DateTime?
  saleNotes    String?

  // Same-day deduplication. When a customer contacts twice in one day (e.g.
  // form submit + phone call), the second contact creates a Lead row pointing
  // at the first via duplicateOfLeadId. Status/saleValue live on the canonical
  // (the row whose duplicateOfLeadId is null). The list views collapse
  // duplicates under the canonical so daily counts aren't inflated, but each
  // contact event remains as its own row.
  duplicateOfLeadId String?
  duplicateOf       Lead?   @relation("LeadDuplicates", fields: [duplicateOfLeadId], references: [id], onDelete: SetNull)
  duplicates        Lead[]  @relation("LeadDuplicates")

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([gclid])
  @@index([email])
  @@index([createdAt])
  @@index([duplicateOfLeadId])
  @@index([clientId, phone, createdAt])
}

enum LeadSource {
  FORM // Quote form submission
  PHONE // Phone call (from HighLevel call tracking)
  CHAT // Live chat
  MANUAL // Manually entered
}

enum LeadStatus {
  NEW // Just received
  CONTACTED // Client reached out
  QUALIFIED // Confirmed good lead
  UNQUALIFIED // Not a good fit
  QUOTED // Quote sent
  SOLD // Converted to sale
  LOST // Lost to competitor or no response
}

// ============================================
// CLIENT USERS (Portal Login)
// ============================================

model ClientUser {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Auth
  email        String  @unique
  name         String?
  passwordHash String? // For password login (optional)

  // Magic Link
  magicLinkToken  String?   @unique
  magicLinkExpiry DateTime?

  // Session
  lastLoginAt DateTime?
  isActive    Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  pushSubscriptions PushSubscription[]

  @@index([clientId])
  @@index([magicLinkToken])
}

// ============================================
// PUSH NOTIFICATIONS
// ============================================

model PushSubscription {
  id           String @id @default(cuid())
  clientUserId String
  clientUser   ClientUser @relation(fields: [clientUserId], references: [id], onDelete: Cascade)

  // Web Push subscription data
  endpoint String @unique
  p256dh   String // Public key for encryption
  auth     String // Auth secret

  // Device info (optional, for debugging)
  userAgent String?

  // Status
  isActive  Boolean   @default(true)
  lastUsed  DateTime?
  failCount Int       @default(0) // Track failed delivery attempts

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientUserId])
  @@index([isActive])
}

// Admin Push Subscriptions (for master-leads notifications)
model AdminPushSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Web Push subscription data
  endpoint String @unique
  p256dh   String // Public key for encryption
  auth     String // Auth secret

  // Device info (optional, for debugging)
  userAgent String?

  // Status
  isActive  Boolean   @default(true)
  lastUsed  DateTime?
  failCount Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Which clients to receive notifications for
  clients AdminPushSubscriptionClient[]

  @@index([userId])
  @@index([isActive])
}

// Junction table for admin subscription -> clients
model AdminPushSubscriptionClient {
  id             String                @id @default(cuid())
  subscriptionId String
  subscription   AdminPushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([subscriptionId, clientId])
  @@index([subscriptionId])
  @@index([clientId])
}


// ============================================
// OUTBOUND WEBHOOK FORWARDING
//
// The app is the single ingestion point for lead forms; each client can
// configure destination webhooks (e.g. their HighLevel inbound webhook) in
// the admin UI. After a lead is stored, the original payload is forwarded
// server-side to every enabled destination. Deliveries are persisted so a
// failed forward is retried by cron instead of lost.
// ============================================

model WebhookDestination {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  label   String // e.g. "HighLevel — Collision workflow"
  url     String // https destination the lead payload is POSTed to
  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([clientId])
}

model WebhookDelivery {
  id            String             @id @default(cuid())
  destinationId String
  destination   WebhookDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  leadId        String?
  lead          Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)

  payload Json // the original inbound payload, forwarded verbatim

  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  lastAttemptAt  DateTime?
  responseStatus Int? // HTTP status of the last attempt
  lastError      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, updatedAt])
  @@index([destinationId, createdAt])
  @@index([leadId])
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

// ============================================
// GBP REVIEWS CACHE (hosted landing pages)
//
// Rating/review data fetched from the Google Places API using the client's
// googlePlaceId. Landing pages render the reviews band and aggregateRating
// JSON-LD ONLY from a row here — never fabricated, stripped when absent.
// A name-match guard refuses to cache data when the Place ID resolves to a
// business that doesn't look like this client (a wrong Place ID returns
// perfectly plausible numbers for someone else's shop).
// ============================================

model ClientGbpReviews {
  id       String @id @default(cuid())
  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  placeName   String // what the Place ID actually resolved to — shown in admin
  rating      Float
  reviewCount Int
  reviews     Json // top review quotes [{author, rating, text, relativeTime}]

  fetchedAt DateTime
  lastError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// PER-CITY PAGE CONTENT
//
// The thing that makes a location page a real page rather than a doorway.
// Without a row here a city page says nothing another city's page doesn't:
// the same services, the same warranty, the same reviews, with the city name
// swapped. Google calls that a doorway page and it is an account-level risk,
// not a ranking nitpick.
//
// A city with a row is indexable and listed. A city without one is still
// served — an ad pointing at it must not 404 — but carries noindex and is
// kept out of the sitemap and the internal links.
// ============================================

model ClientCityContent {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /* Matched case-insensitively against the service-area name. */
  city String

  /* The client's own words about working in this city. */
  heading String?
  body    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, city])
  @@index([clientId])
}

// ============================================
// CUSTOM DOMAINS (hosted landing pages)
//
// A client's own domain serving their hosted site. The site always keeps
// answering on {label}.glassleads.app as well — a custom domain is an
// addition, never a replacement, so a DNS mistake can never take the site
// off the internet.
//
// isPrimary picks the host used for canonical URLs, share cards and the
// sitemap. Search engines need one answer to "where does this page live",
// and serving the same page on two hosts without saying which is canonical
// splits the ranking signal between them.
// ============================================

model ClientDomain {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /* Bare hostname, lowercase, no scheme: "collisionautoglass.com". */
  domain String @unique

  /* The host canonical URLs point at. Exactly one per client, enforced when
   * the set is written. */
  isPrimary Boolean @default(false)

  /* Last known state from Vercel. Cached so the admin list renders without
   * an API call per row; the detail view refreshes it on demand. */
  verified      Boolean   @default(false)
  misconfigured Boolean   @default(true)
  lastCheckedAt DateTime?
  lastError     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

// ============================================
// GOOGLE ADS CONVERSION TRACKING (hosted landing pages)
//
// Nothing is emitted without a row here and a conversion ID in it: no row,
// no gtag, no third-party script on the client's page. That is deliberate —
// a tag firing to the wrong account is worse than no tag.
//
// Kept out of Client on purpose. A new table is order-independent against the
// deploy (reads are guarded), whereas adding scalar columns to Client breaks
// every query on that table if the code ships before the SQL.
// ============================================

model ClientAdsTracking {
  id       String @id @default(cuid())
  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /* "AW-123456789". The whole feature is gated on this being present. */
  conversionId String?

  /* Conversion action labels, the part after the slash in "AW-xxx/LABEL".
   * Both are extracted from the snippet the operator pastes rather than typed,
   * so there is no chance of splitting the pair at the wrong place. */
  leadConversionLabel String?
  /* Value carried by the lead conversion, when the action defines one. */
  leadValue    Float?
  leadCurrency String?

  /* "Calls from a website". Google swaps callPhoneNumber on the page for a
   * forwarding number and reports calls over the configured duration, so the
   * number has to be stored exactly as the snippet gives it. Optional and
   * deliberately separate — leave it unset when HighLevel's Number Pool
   * Calling is doing the swap, because two swap systems on one number fight. */
  callConversionLabel String?
  callPhoneNumber     String?

  /* Send hashed email/phone with the conversion. Both networks hash in the
   * browser; nothing identifiable is stored here. Applies to Google and
   * Microsoft alike — the same lead, reported to whichever is configured. */
  enhancedConversions Boolean @default(true)

  /* --- Microsoft Advertising (Bing) ---
   * UET is Microsoft's equivalent of the Google tag: one numeric tag id per
   * advertiser, installed once. Conversions are then "event goals" matched by
   * action name, which is why the action is stored rather than assumed — it
   * has to be typed identically in the goal and here or the goal never fires. */
  bingUetTagId        String?
  bingLeadEventAction String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// ADDITIONAL SHOP LOCATIONS (multi-GBP clients)
//
// A client with one shop needs no rows here — the Client scalar address is
// the location, and getClientLocations() synthesizes a single row from it.
// A client with several shops (several Google Business Profiles) gets one
// row per shop, and from that point the rows are the truth: the map section,
// the footer, the location pages, and the JSON-LD all read from them.
//
// Each row carries its own Place ID so its rating is that shop's rating.
// Ratings are NEVER averaged across shops — a blended number is a number no
// Business Profile actually shows.
// ============================================

model ClientLocation {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // How the shop is referred to on the page ("NW Portland", "Tualatin").
  label         String
  streetAddress String
  city          String
  state         String
  postalCode    String
  country       String  @default("US")
  // Blank means the shop uses the client's main number.
  phone         String?
  // Free text ("Mon–Fri 8–5, Sat 9–2") — rendered verbatim, never parsed.
  hours         String?

  googlePlaceId String?
  googleMapsUrl String?

  // Cached Google Business Profile data for THIS shop's profile. Same rules
  // as ClientGbpReviews: written only after a name-match guard passes, and
  // the site strips the rating entirely when absent.
  gbpPlaceName   String?
  gbpRating      Float?
  gbpReviewCount Int?
  gbpFetchedAt   DateTime?
  gbpLastError   String?

  // The shop the site leads with when no city context narrows it down.
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

// ============================================
// HOSTED SITE CONTENT (editorial fields + photos)
//
// Everything here is optional, and every site section backed by it is
// REMOVED when its content is empty — never rendered as an empty shell,
// never filled with invented facts. This ports the landing-template rules:
// a lifetime warranty is defined on-page in full beside the claim, the
// registration line renders only when a number is set, FAQs and photos are
// per-client editorial content entered in the admin, not generated.
// ============================================

model ClientSiteContent {
  id       String @id @default(cuid())
  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Warranty band. Rendered only when set, and always in full — a warranty
  // claim without its definition beside it is a compliance failure.
  warrantyTitle String? // e.g. "Lifetime Workmanship Warranty"
  warrantyText  String? @db.Text

  // FAQ section + FAQPage JSON-LD. [{ q, a }]
  faq Json?

  // Hero bullets — the claims under the H1. [{ lead, text }]. When absent the
  // page falls back to its generic trust chips. No carrier names, no
  // certifications the shop doesn't hold, no timing promises.
  heroBullets Json?

  // Editorial chapters between the hero and the services grid, like the
  // reference build's long-form middle. [{ heading, body, photoUrl }] —
  // written per business (or drafted by the importer from the client's own
  // site copy), never invented. Reads are defensive: pages query this column
  // separately so a DB that predates it only loses chapters, nothing else.
  chapters Json?

  // Footer one-liner about the business.
  footerBlurb String?

  // Regulator line (e.g. California ARD: 16 CCR § 3371.2 requires the
  // registered name and number in internet advertising). Renders only when
  // number is set.
  registrationName   String?
  registrationNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SitePhotoPool {
  GALLERY // the "range of work" grid
  BODY    // process/detail shots beside prose on service pages
}

model ClientSitePhoto {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  url       String
  alt       String // plain-text description; also the accessibility text
  pool      SitePhotoPool @default(GALLERY)
  sortOrder Int           @default(0)

  createdAt DateTime @default(now())

  @@index([clientId, pool, sortOrder])
}

// ============================================
// CALL ANALYSIS (Coaching reports for phone leads)
// ============================================

model CallAnalysis {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  leadId   String?
  lead     Lead?  @relation(fields: [leadId], references: [id], onDelete: SetNull)

  // HighLevel references
  highlevelCallId    String?
  highlevelContactId String?

  // Audio
  recordingUrl     String? // Original URL from HighLevel (Deepgram pulls from this)
  durationSeconds  Int?
  callDirection    String? // inbound | outbound
  callerPhone      String?
  repPhone         String?

  // Pipeline status
  status       CallAnalysisStatus @default(PENDING)
  errorMessage String?            @db.Text

  // Results
  transcript    Json? // Full Deepgram response
  audioMetrics  Json? // Computed talk ratios, interruptions, gaps
  analysis      Json? // Full Claude analysis object
  score         Int? // Denormalized from analysis.score for sorting/filtering
  outcome       String? // Denormalized from analysis.outcome

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([clientId, createdAt])
  @@index([status])
  @@index([leadId])
  @@index([clientId, score])
}

enum CallAnalysisStatus {
  PENDING
  DOWNLOADING
  TRANSCRIBING
  ANALYZING
  COMPLETE
  FAILED
}

// ============================================
// SETTINGS
// ============================================

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String // Encrypted for sensitive values
  encrypted Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
