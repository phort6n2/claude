# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Temporary review screenshots (not part of the app)
/scratchpad-shots/

# Throwaway Playwright/diagnostic scripts written into the repo root while
# driving the app during a review. Agents write these here because that is
# where `require('playwright')` resolves, and a `git add -A` swept five of
# them into main once. They are never part of the app.
#
# .mjs as well as .js: the rule was written for one naming habit and every
# script since has been an ES module, so the pattern quietly stopped matching
# the thing it exists to catch.
/_*.js
/_*.mjs
/agent-*.mjs
/*-shot.mjs
/*-shots.mjs
/*-check.mjs
/*-test.mjs
